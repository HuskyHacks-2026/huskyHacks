{
  "name": "agent-alias-vault-demos",
  "private": true,
  "type": "module",
  "description": "Locked demo scenarios + end-to-end test cases for the Agent Alias Vault backend. Does not modify backend/ or frontend/.",
  "scripts": {
    "demo": "tsx src/run.ts",
    "test": "vitest run",
    "test:live": "API=http://localhost:8787/api vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test:ui": "node e2e/test-cases.mjs",
    "test:ui:demo": "node e2e/live-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "playwright-core": "^1.48.0"
  }
}
