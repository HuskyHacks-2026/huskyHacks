# "mock" (default) = in-browser fake backend. "http" = call a real/mock server.
VITE_API_MODE=mock
# same-origin on Vercel; locally: http://localhost:8787/api
VITE_API_BASE_URL=/api
VITE_MEMBER_TOKEN=demo-member-token
# Fake latency for the in-browser mock, in ms (makes the demo feel real)
VITE_MOCK_LATENCY_MS=600
