{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "VITE_API_MODE": "http",
      "VITE_API_BASE_URL": "/api"
    }
  }
}
